# ==============================================================================
# DirectorOps Environment Configuration
# ==============================================================================

# Mode: Set to true to run fully offline/deterministic without live API keys
DEMO_MODE=true

# Google Cloud Gemini Configuration
# Obtain your key at: https://aistudio.google.com/ or via Google Cloud Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Grafana Cloud Configuration (Free tier: https://grafana.com/products/cloud/)
# Your Grafana stack URL (e.g. https://yourstack.grafana.net)
GRAFANA_URL=https://your-stack.grafana.net

# Grafana Service Account Token with Editor role (glsa_...)
GRAFANA_SA_TOKEN=glsa_your_service_account_token_here

# Grafana Cloud Prometheus OTLP / Remote Write endpoint (Optional for live push)
GRAFANA_PROMETHEUS_ENDPOINT=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=your_prometheus_user_id

# Grafana Cloud Loki Push endpoint (Optional for live push)
GRAFANA_LOKI_ENDPOINT=https://logs-prod-006.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=your_loki_user_id

# Server Port
PORT=8000
HOST=0.0.0.0
